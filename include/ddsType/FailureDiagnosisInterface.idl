
//开机自检请求（故障诊断模块-->故障源模块）
struct SelfInspectionReq
{
    unsigned long sn;  //流水号，暂无用途。故障源模块完成初始化，回复后退出可以topic监听
};


//故障源模块枚举，只可在max前增加记录，不可破坏已有模块顺序！
enum FailureModule_Enum
{
    FailureModule_Unknow,
    FailureModule_Vehicle_Instrument_IC,  //车身-组合仪表IC
    FailureModule_Vehicle_SYMC_Control,  //车身-SYMC电器控制系统
    FailureModule_Vehicle_XIANFC_Gearbox_TCU,  //车身-双特变速箱TCU
    FailureModule_Vehicle_WEICHAI_Engine_ECU,  //车身-潍柴发动机ECU
    FailureModule_Vehicle_DANFOSS_Steering_1,  //车身-丹佛斯转向系统1
    FailureModule_Vehicle_DANFOSS_Steering_2,  //车身-丹佛斯转向系统2
    FailureModule_Vehicle_EBS_Control_KORMEE,  //车身-EBS控制器科密
    FailureModule_Vehicle_VCU_Control,  //车身-VCU控制器
    FailureModule_Vehicle_ACU_Control,  //车身-ACU控制器
    FailureModule_Vehicle_IGW_Control,  //车身-IGW控制器
    FailureModule_Vehicle_EV_Chassis,  //车身-电车车身系统故障
    FailureModule_Vehicle_EV_Engine,  //车身-电车电机故障
    FailureModule_Vehicle_EV_Battery,  //车身-电车电池故障
    FailureModule_Perception,  //感知故障
    FailureModule_Location,  //定位故障
    FailureModule_Control,  //控制故障
    FailureModule_Pilot_Decide,  //主控-决策模块
    FailureModule_Pilot_Control,  //主控-控制模块
    FailureModule_Pilot_GlobalPlan,  //主控-全局规划
    FailureModule_Pilot_LocalPlan,  //主控-局部规划
    FailureModule_Pilot_LaneMaker,  //主控-路径规划
    FailureModule_Pilot_LaneLoader,  //主控-路径读取
    FailureModule_Pilot_Interaction,  //主控-通信模块
    FailureModule_Pilot_Log,  //主控-日志模块
    FailureModule_Perception_PerceptionDriver,  //感知-驱动模块
    FailureModule_Perception_Lidar,  //感知-激光雷达进程
    FailureModule_Perception_Radar,  //感知-毫米波雷达进程
    FailureModule_Perception_Camera,  //感知-图像模块进程
    FailureModule_Perception_Fusion,  //感知-融合进程
    FailureModule_Nebula_Frpc,  //星云-远程SSH
    FailureModule_Nebula_NetClould,  //星云-车云通信
    FailureModule_Nebula_RemoteCtrl,  //星云-遥控驾驶
    FailureModule_Pilot_Guard,  //主控-守护进程
    FailureModule_FailureDiagnosis,  //主控-故障诊断模块
    FailureModule_VCUMessageTransformer,  //主控-VCUMessageTransformer    特殊处理！！！各车身模块都关联到该模块上

    FailureModule_MAX
};

//故障源状态枚举，只可在max前增加记录，不可破坏已有模块顺序！
enum SelfInspectionStatus_Enum
{
    SelfInspectionStatus_Unknow,  //初始未知状态
    SelfInspectionStatus_Initializing,  //初始化中
    SelfInspectionStatus_initialized,  //初始化完成
    SelfInspectionStatus_ReadyToWork,  //正常工作

    SelfInspectionStatus_Max
};

//开机自检响应（故障源模块-->故障诊断模块）
struct SelfInspectionResp
{
    FailureModule_Enum failuremodule;  //各模块填写自己对应的枚举值
    SelfInspectionStatus_Enum status;  //当前状态
};


//故障收集（故障源模块-->故障诊断模块）
struct FailureCollection
{
    unsigned long failureCode;  //故障编号，参见函数failurecodeCombination
    unsigned long activeFlag;  //0x00表示清除，0x01表示产生
};


//故障上报（故障诊断模块-->通信服务模块）
struct FailureReportCloud
{
    unsigned long long timestamp;  //时间戳
    char failuremodule;  //模块名，取值含义请见FailureModule_Enum
    char measure;  //处理措施编号
    char level;  //故障等级
    char activeflag;  //故障状态，0x00为清除，0x01为产生
    unsigned long failureCode;  //故障编号，参见函数failurecodeCombination
};

//故障上报（故障诊断模块-->主控）
struct FailureReportMainControl
{
    char measure;  //处理措施编号
    char level;  //故障等级
    char activeflag;  //故障状态，0x00为清除，0x01为产生
    char pad;
};


//20221123 zhangl1490 增加故障信息车云同步功能，Start
//故障状态文件生成请求（通信模块-->故障诊断模块）
struct FailureStatusFileCreateReq
{
    unsigned long requestSn;
};

//故障状态文件生成响应（故障诊断模块-->通信模块）
struct FailureStatusFileCreateResp
{
    unsigned long requestSn;
    string filename;
};

//故障状态文件解析成功通知（通信模块-->故障诊断模块）
struct FailureStatusFileParseComplete
{
    unsigned long requestSn;
};

//故障状态文件解析成功通知ACK（故障诊断模块-->通信模块）
struct FailureStatusFileParseCompleteAck
{
    unsigned long requestSn;
};
//20221123 zhangl1490 增加故障信息车云同步功能，End



