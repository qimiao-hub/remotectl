struct TransportProtocolConnectionManage
{
    unsigned long control_byte; // 控制字节
    unsigned long total_message_size; // 总信息字节数
    unsigned long total_number_of_packets; // 总包数
    unsigned long PGN;
};

struct TransportProtocolDataTransfer
{
    unsigned long sequence_number;
    unsigned long packetized_data;
};


struct WirectlFeedbackInfo
{
    //Engine information
    unsigned long engine_torque_mode; // 发动机扭矩模式
    //电车
    short main_DriveMotor_Tem_raw;//主电机温度 offset -40
    float main_driveMotor_speed_raw;//主电机转速 offset -6000
    float main_DriveMotor_Current_raw;//主电机电流 offset -3000
    short mainDriveMotorControllerTemp_raw;//主控制器温度 offset -40
    float Powertrain_outputTorque;//动力总成输出扭矩 offset -3000
    //油车
    float actual_engine_fractional_torque; // 发动机附加扭矩，单位：%
    short driver_demand_engine_percent_torque; // 驾驶指令百分比扭矩，单位：%
    short actual_engine_torque; // 发动机实际扭矩百分比，单位：%
    unsigned long engine_speed; // 发动机转速，单位：rpm
    unsigned long src_address_ctrl_dev_for_engine; // 控制发动机的设备地址
    //
    short accel_pedal_position; // 油门踏板位置，单位：%
    boolean accelerator_requestStatus;//油门请求状态
    short engine_demand_percent_torque; // 发动机需求扭矩百分比,单位：%

    boolean vehicle_loss_ctrl;//车辆失控


    //Brake infomation
    short brake_pedal_SYMC; // SYMC制动深度，单位：%
    short actual_retarder_percent_torque; // 缓速器档位，单位：%
    float foot_valve_info; // 脚阀传感器信号，单位：Mpa
    boolean parking_brake_signal_status; // 驻车制动信号状态，0：驻车 1：不驻车(车辆直接反馈)
    boolean exhaust_brake_status; // 排气制动状态，0：断开 1：闭合
    boolean hydraulic_startup_status; // 液压缓行启动状态，0：OFF 1:ON

    //Steer infomation
    float steering_angle_request; // 单位：度
    float steering_left_angle_info;
    float steering_right_angle_info;


    //Transmission information
    long trans_current_gear; // 变速箱当前档位信息
                                // N：0
                                // R：-1
                                // D1：1
                                // D2：2
                                // D3：3
                                // D4：4
                                // D5：5
                                // D6：6
    // ECM Hours  &&  Battery information1
    float Accumulated_charged_electric_quanlity;//累计充电电量
    float Accumulated_discharged_electric_quanlity;//累计放电电量
    short Single_charged_electric_quanlity;//单次充电电量
    float Battery_power_raw; // 电池功率
    float engine_total_hours; // 发动机工作总时长
    float battery_voltage; //蓄电池电压
    unsigned long Acc_Power_On_Status;//Acc电源状态
    unsigned long Charge_Gun_Status;//充电枪状态
    unsigned long Force_State;//取力状态
    unsigned long Vehicle_Remote_Start_Error;//车辆远程启动错误

    //Body electrical information1
    unsigned long transmission_requested_range;//变速器请求换档范围
    unsigned long shifting_gears;//是否正在换档
    unsigned long Locking_gearboxTorqueConverter;//缓速器锁止状态
    unsigned long lift_condition; // 货箱升降状态，
                            // 0x0无动作
                            // 0x1正在举升
                            // 0x2正在下降
    boolean lift_longo_position_status; // 举升到位接近开光状态，0：OFF 1：ON
    boolean drop_longo_position_status; // 下降到位接近开光状态，0：OFF 1：ON
    boolean left_turn_start_status; // 左转向灯启动状态，0：OFF 1：ON
    boolean right_turn_start_status; // 右转向灯启动状态，0：OFF 1：ON
    boolean hazard_start_status; // 危险警报灯启动状态，0：OFF 1：ON
    boolean flash_start_status; // 爆闪灯启动状态，0：OFF 1：ON
    boolean fog_lamp_start_status; // 雾灯启动状态，0：OFF 1：ON
    boolean outline_lamp_start_status; // 示廓灯启动状态，0：OFF 1：ON
    boolean low_light_start_status; // 近光灯启动状态，0：OFF 1：ON
    boolean high_beam_start_status; // 远光灯启动状态，0：OFF 1：ON
    boolean head_light_status; // 前照灯状态，0：OFF 1：ON
    boolean rear_light_start_status; // 后照灯启动状态，0：OFF 1：ON
    boolean wiper_start_status; // 雨刮喷水启动状态，0：OFF 1：ON
    boolean wiper_longermit_start_status; // 雨刮间歇启动状态，0：OFF 1：ON
    boolean wiper_slow_start_status; // 雨刮低速启动状态，0：OFF 1：ON
    boolean wiper_high_start_status; // 雨刮高速启动状态，0：OFF 1：ON
    boolean horn_start_status; // 喇叭启动状态，0：OFF 1：ON
    boolean axle_differential; // 轴差，0：OFF 1：ON
    boolean go_to_unmanned_status; // 进入无人驾驶状态，0：不允许 1：允许
    boolean slow_light_start_status; // 缓行灯启动状态，0：OFF 1：ON
    boolean brake_light_start_status; // 制动灯启动状态，0：OFF 1：ON
    boolean revers_light_start_status; // 倒车灯启动状态，0：OFF 1：ON
    boolean charge_indicator; // 充电指示，0：OFF 1：ON
    unsigned long vehicle_status; // 车辆状态 0： On档 1：启动 2：启动失败

    //tire pressure
    unsigned long Front_L_tire_pressure;//前左轮轮胎压力
    unsigned long Front_R_tire_pressure;//前右轮轮胎压力
    unsigned long MID_LL_tire_pressure;//中左左轮轮胎压力
    unsigned long MID_LR_tire_pressure;//中左右轮轮胎压力
    unsigned long MID_RL_tire_pressure;//中右左轮轮胎压力
    unsigned long MID_RR_tire_pressure;//中右右轮轮胎压力
    unsigned long BACK_LL_tire_pressure;//后左左轮轮胎压力
    unsigned long BACK_LR_tire_pressure;//后左右轮轮胎压力
    unsigned long BACK_RL_tire_pressure;//后右左轮轮胎压力
    unsigned long BACK_RR_tire_pressure;//后右右轮轮胎压力

    //轮边压力
    unsigned long Brake_Pressure_FA_Left;//制动压力前桥左
    unsigned long Brake_Pressure_FA_Right;//制动压力前桥右
    unsigned long Brake_Pressure_RA1_Left;//制动压力后桥左
    unsigned long Brake_Pressure_RA1_Right;//制动压力前桥右

    //tire temperature
    short Front_L_tire_temperature;//前左轮胎温
    short Front_R_tire_temperature;//前右轮胎温
    short MID_LL_tire_temperature;//中左左轮胎温
    short MID_LR_tire_temperature;//中左右轮胎温
    short MID_RL_tire_temperature;//中右左轮胎温
    short MID_RR_tire_temperature;//中右右轮胎温
    short BACK_LL_tire_temperature;//后左左轮胎温
    short BACK_LR_tire_temperature;//后左右轮胎温
    short BACK_RL_tire_temperature;//后右左轮胎温
    short BACK_RR_tire_temperature;//后右右轮胎温


    //tire error code
    unsigned short Front_L_tire_code;//前左轮胎压故障码
    unsigned short Front_R_tire_code;//前右轮胎压故障码
    unsigned short MID_LL_tire_code;//中左左轮胎压故障码
    unsigned short MID_LR_tire_code;//中左右轮胎压故障码
    unsigned short MID_RL_tire_code;//中右左轮胎压故障码
    unsigned short MID_RR_tire_code;//中右右轮胎压故障码
    unsigned short BACK_LL_tire_code;//后左左轮胎压故障码
    unsigned short BACK_LR_tire_code;//后左右轮胎压故障码
    unsigned short BACK_RL_tire_code;//后右左轮胎压故障码
    unsigned short BACK_RR_tire_code;//后右右轮胎压故障码

    //air_conditioner
    boolean air_power_status;//空调开关状态
    boolean air_auto_status;//空调自动状态
    boolean air_ac_status;//空调AC制冷状态
    boolean air_defrost_status;//空调除霜状态
    boolean air_cyclemode_status;//循环模式状态
    unsigned short air_outletmode_status;//吹风模式状态
    unsigned short air_level_status;//空调风量状态
    unsigned short air_temperature_statusR;//设定温度
    short cab_temperature_status;//驾驶舱温度

    //EBS light
    unsigned short EBS_red_alarmlight;
    unsigned short EBS_yellow_alarmlight;
    
    //brake hold state
    unsigned short Brake_Hold_state;

    //VCU版本号
    string VCU_Version;
    
    //电车
    short ramp_sensor;//坡度传感器
    // Aux motor information
    short rxauxiliary_DriveMotor_Tem_raw;//辅电机温度 offset -40
    float rxauxiliary_driveMotor_speed_raw;//辅电机转速 offset -6000
    float rxauxiliary_DriveMotor_Current_raw;//辅电机电流 offset -3000
    short rxauxiliarDriveMotorControllerTemp_raw;//辅电机控制器温度 offset -40

    //Battery information2
    unsigned long endurance_mileage;//剩余里程
    unsigned long power_consumption;//瞬时电耗
    unsigned long SOC;//荷电状态（剩余电量）
    unsigned long charging_state;//充电状态
    unsigned long Battery_State;//电池状态
    float Battery_Current;//电池电流 offset -1000
    short Battery_Temperature_raw;//电池温度 offset -40
    unsigned long Battery_Fault_Status;//电池故障状态
    unsigned long energy_recover;//能量回收状态
    // Engine Temperature
    float engine_coolant_temperature; // 发动机冷却水温度，单位：摄氏度
    float fuel_temperature; // 燃油温度，单位：摄氏度
    float engine_oil_temperature; // 机油温度，单位：摄氏度

    // Engine Fluid Level/Pressure
    float engine_oil_level; // 机油液位，单位：%
    float engine_oil_pressure; // 机油压力，单位：kpa

    // Fuel Economy (Liquid)
    float engine_fuel_rate; // 油耗，单位：L/h
    float engine_instant_fuel_economy; // 瞬时油耗，单位：km/L
    float engine_average_fuel_economy; // 平均燃油经济性，单位：km/L
    short fuel_level; // 油量，单位：%
    unsigned long Engine_wait_to_lamp;//发动机进气预热指示

    //Body electrical information2
    float air_pressure_1; // 单位：MPa
    float air_pressure_2; // 单位：MPa
    float front_axle_running_brake_pressure_input;//前桥行车制动压力输入0~2.55
    float brake_pressure_input_in_middle_axle;//中桥行车制动压力输入0~2.55
    float rear_axle_running_brake_pressure_input;//后桥行车制动压力输入0~2.55
    unsigned long weighing_cell_1;//称重传感器10~255
    unsigned long weighing_cell_2;//称重传感器20~255
    unsigned long num_297;//297与控制的心跳

    // Wheel speed information
    float front_left_wheel_speed; // 前左轮车速，单位：km/h
    float front_right_wheel_speed; // 前右轮车速，单位：km/h
    float rear_left_wheel_speed; // 后左轮车速，单位：km/h
    float rear_right_wheel_speed; // 后右轮车速，单位：km/h


    // Tachograph
    float tachograph_output_shaft_speed; // 变速箱输出轴转速，单位： rpm
    float tachograph_vehicle_speed; // 车速，单位：km/h
    float total_vehicle_distance; // 单位：m


    //fuel consumption
    float engine_totalFuel_used;//发动机总油耗 单位：L
    float trip_fuel_consumption;//发动机旅程油耗 单位：L

    // Wheel angle sensor information
    float steering_left_angle_info_mv; // 单位：mv
    float steering_right_angle_info_mv; // 单位：mv

    unsigned long vcu_state;
    unsigned long udpindex;

    // DM1_ECM -- Active Diagnostic Trouble Codes
    ActiveDiagnosticTroubleCodes dm1_ecm_diag_trouble;

    // ECM -- Transport Protocol-Connection Management
    TransportProtocolConnectionManage ecm_tpcm;

    // ECM -- Transport Protocol-Data Transfer
    TransportProtocolDataTransfer ecm_tpdt;

    // DM1_TCU -- Active Diagnostic Trouble Codes
    ActiveDiagnosticTroubleCodes dm1_tcu_diag_trouble;

    // TCU -- Transport Protocol-Connection Management
    TransportProtocolConnectionManage tcu_tpcm;

    // TCU -- Transport Protocol-Data Transfer
    TransportProtocolDataTransfer tcu_tpdt;

    // SCA(Safety_Controller_Alarm) -- Active Diagnostic Trouble Codes
    ActiveDiagnosticTroubleCodes sca_diag_trouble;
    ActiveDiagnosticTroubleCodes sca_diag_trouble1;
    ActiveDiagnosticTroubleCodes sca_diag_trouble2;
    // MCA(Main_Controller_Alarm) -- Active Diagnostic Trouble Codes
    ActiveDiagnosticTroubleCodes mca_diag_trouble;
    ActiveDiagnosticTroubleCodes mca_diag_trouble1;
    ActiveDiagnosticTroubleCodes mca_diag_trouble2;

    // not clear
    float on_voltage; // On档电压
    boolean parking; // 驻车，0：OFF 1：ON
    unsigned long low_air_pressure_alarm; // 气压过低警报，01：ON 10：OFF

    /*VCU反馈控制信息及电车故障码*/
    boolean Autopilot_enable_bit;//自动驾驶使能位
    boolean Power_control_enable_bit;//动力控制使能位
    boolean Shift_request_status;//挂挡请求状态
    boolean accelerator_request_status;//油门请求状态
    boolean Parking_request;//驻车请求
    boolean Brake_request_status;//刹车请求状态
    boolean No15_power_supply_control;//15号电源控制
    boolean Brake_light_control;//制动灯控制

    unsigned long Gear_request;//挡位请求
    boolean ACC_power_control;//ACC电源控制
    unsigned long Container_control;//货箱控制
    boolean Left_turn_signal;//左转向灯
    boolean Right_turn_signal;//右转向灯

    unsigned long accelerator_request;//油门请求

    unsigned long Brake_request;//制动请求

    boolean backup_light;//倒车灯控制
    boolean Fog_lamp_control;//雾灯控制
    boolean Small_lights;//小灯控制
    boolean lower_beam_lamb;//近光灯控制
    boolean higher_beam_lamb;//远光灯控制
    boolean Wipers_spray_water;//雨刮喷水控制
    boolean Wiper_intermission;//雨刮间歇控制
    boolean Wiper_low_speed;//雨刮低速控制

    boolean Wiper_high_speed;//雨刮高速控制
    boolean Axle_lock_control;//轴锁控制
    boolean Power_takeoff_start;//取力启动
    boolean Flash_lamp;//爆闪灯控制
    boolean Headlights;//前照灯控制
    boolean Rear_light;//后照灯控制
    boolean Horn_on;//喇叭启动
    boolean S_gear_control;//S档控制

    boolean Emergency_Stop_Switch_Status60;//急停开关状态
    boolean Hazard_Warning_Lamp_Control54;//危险警报灯控制
    unsigned long Remote_or_Unman;// 反馈8为遥控   6为无人

    unsigned short Steer_1_Curvature_control;//VCU外发转向系统1控制曲率

    unsigned short Steer_2_Curvature_control;//VCU外发转向系统2控制曲率
};


