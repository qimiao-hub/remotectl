struct ActiveDiagnosticTroubleCodes
{
    unsigned long protect_lamp_status; // 00:OFF 01:ON
    unsigned long amber_warning_lamp_status; // 00:OFF 01:ON
    unsigned long red_stop_lamp_status; // 00:OFF 01:ON
    unsigned long malfunction_indicator_lamp_status; // 00:OFF 01:ON
    unsigned long flash_protect_lamp; //
                            // 00 Slow Flash -1 Hz
                            // 01 Fast Flash-2 Hz or faster
                            // 11 Uinavailable / Do Not Flash
    unsigned long flash_amber_warn_lamp; //
                            // 00 Slow Flash -1 Hz
                            // 01 Fast Flash-2 Hz or faster
                            // 11 Uinavailable / Do Not Flash
    unsigned long flash_red_stop_lamp;
                            // 00 Slow Flash -1 Hz
                            // 01 Fast Flash-2 Hz or faster
                            // 11 Uinavailable / Do Not Flash
    unsigned long flash_malfunction_indicator_lamp;
                            // 00 Slow Flash -1 Hz
                            // 01 Fast Flash-2 Hz or faster
                            // 11 Uinavailable / Do Not Flash
    unsigned long SPN_LSB; // suspect parameter number
    unsigned long SPN_MSB;
    unsigned long FMI; // failure mode identifier
            //     0 Data Valid but above Normal Operating Range
            //     1 Data Valid but below Normal Operating Range
            //     2 Data Erratic, longermittent or Incorrect
            //     3 Voltage above Normal or Shorted to High Source
            //     4 Voltage below Normal or Shorted to Low Source
            //     5 Current below Normal or Open Circuit
            //     6 Current above Normal or Grounded Circuit
            //     7 Mechanical System Not Responding or out of adjustment
            //     8 Abnormal frequency or pulse width or period
            //     9 Abnormal Update Rate
            // 10 Abnormal Rate of Change
            // 11 Root Cause Not Know
            // 12 Bad longelligent Device or Component
            // 13 Out of Calibration
            // 14  Special Instructions
            // 15 Data Valid But Above Normal Operating Range (Least Severe Level)
            // 16 Data Valid But Above Normal Operating Range (Moderate Sever Level)
            // 17 Data Valid But Below Normal Operating Range (Least Severe Level)
            // 18 Data Valid But Below Normal Operating Range (Moderate Severe Level)
    unsigned long occurence_count;
    boolean conversion_method; // 0:低字节在前 1：低字节在后
};

struct FaultDiagnosisFrom297Info
{
    //VCU fault diagnosis
    boolean tbox_on_line;//Tbox在线状态  1在线状态
    boolean acu_on_line;//ACU在线状态
    boolean symc_on_line;//SYMC在线状态
    boolean ebs_on_line;//EBS在线状态
    boolean ic_on_line;//IC在线状态
    boolean ecm_on_line;//ECM在线状态
    boolean tcu_on_line;//TCU在线状态
    boolean steering_controller_1_on_line;//转向控制器1在线状态
    boolean sas_sensor_on_line;//SAS传感器在线状态
    boolean wheel_angle_sensor_on_line;//车轮角度传感器在线状态
    boolean steering_controller_2_on_line;//转向控制器2在线状态
    boolean wheel_angle_sensor_2_on_line;//车轮角度传感器2在线状态
    boolean vcu_on_line;//VCU在线状态
    boolean inertial_navigation_on_line;//惯导在线状态
    boolean electromagnetic_switch_state;//电磁开关状态
    boolean electric_start_enable_state;//On档电启动使能状态
    boolean vehicle_start_control_state;//车辆启动控制状态
    boolean enters_unmanned_driving_state;//进入无人驾驶状态
    boolean vehicle_speed;//车速
    boolean vehicle_start_state;//车辆启动状态
    boolean vehicle_gear_state;//车辆档位状态
    boolean parking; // 驻车状态，0：OFF 1：ON
    boolean request_switch_reset_state;//请求开关复位状态
    boolean car_reset_state;//车厢复位状态
    boolean can_bus_communication_state;//CAN总线通信状态
    boolean unmanned_driving_system_state;//无人驾驶系统状态
    boolean steering_system_state;//转向系统状态
    boolean symc_agrees_state;//SYMC同意状态
    boolean tbox_request_state;//TBOX请求状态
    boolean shift_switching_state;//档位切换状态
    boolean cloud_exit;//(无人驾驶系统退出)
    boolean traffic_brake_take_over;//行车制动接管
    boolean unmanned_warping_switch_Reset;//无人驾驶翘板开关复位
    boolean symc_offline;//SYMC掉线
    boolean power_CAN_offline;//动力CAN掉线
    boolean steering_system_Abnormal;//转向系统异常
    boolean car_end_Level_3_fault;//车端3级故障
    boolean unmanned_driving_system_Level_3_fault;//无人驾驶系统3级故障
    boolean SYMC_abnormally_exits;//SYMC异常退出
    boolean emergency_stop_switch;//急停开关
    boolean vehicle_end_control_signal_does_not_respond_substandard;//车端控制信号不响应不达标
    boolean vehicle_control_deviates_from_the_route;//车控偏离路线
    boolean throttle_take_over_state;//油门接管状态

    //Vehicle fault diagnosis
    unsigned long vehicle_failure_grade;//车辆故障等级
    unsigned long vehicle_error_source;//车辆故障来源
    unsigned long gearbox_fault_level;//变速箱故障等级
    unsigned long gearbox_SPN_LSN;//变速箱SPN_LSN
    unsigned long gearbox_SPN_MSB;//变速箱SPN_MSB
    unsigned long gearbox_FMI;//变速箱FMI
    unsigned long steering_1_safety_controller_failure_level;//转向1安全控制器故障等级
    unsigned long turn_to_1_safety_controller;//转向1安全控制器SPN_LSN
    unsigned long turn_to_1_safety_controller_SPN_MSB;//转向1安全控制器SPN_MSB
    unsigned long steering_1_safety_controller_FMI;//转向1安全控制器FMI
    unsigned long steering_1_main_controller_failure_level;//转向1主控制器故障等级
    unsigned long turn_to_1_master_controller_SPN_LSN;//转向1主控制器SPN_LSN
    unsigned long go_to_1_master_controller_SPN_MSB;//转向1主控制器SPN_MSB
    unsigned long turn_to_1_main_controller_FMI;//转向1主控制器FMI
    unsigned long steering_2_safety_controller_failure_level;//转向2安全控制器故障等级
    unsigned long steering_2_safety_controller_SPN_LSN;//转向2安全控制器SPN_LSN
    unsigned long steering_2_Safety_Controller_SPN_MSB;//转向2安全控制器SPN_MSB
    unsigned long steering_2_Safety_Controller_FMI;//转向2安全控制器FMI
    unsigned long steering_2_main_controller_failure_level;//转向2主控制器故障等级
    unsigned long turn_to_2_master_controller_SPN_LSN;//转向2主控制器SPN_LSN
    unsigned long go_to_2_master_controller_SPN_MSB;//转向2主控制器SPN_MSB
    unsigned long turn_to_2_main_controller_FMI;//转向2主控制器FMI

    unsigned long ControlByte;//控制字节
    float TotalNumberByte;//总字节包数
    unsigned long TotalNumberPacket;//总包数
    float PGN;
    unsigned long SequenceNumber;//多包序号
    //多包信息
    unsigned long TP_DT_Byte1;//FMI  
    float TP_DT_Byte2_3;//SPN_LSB
    unsigned long TP_DT_Byte4;//故障等级
    unsigned long TP_DT_Byte5;//0：无故障 1：车身-组合仪表IC 2：SYMC电器控制系统 3：车身-变速箱TCU 4：车身-潍柴发动机ECU 5：车身-丹佛斯转向系统1 6：车身-丹佛斯转向系统2
    //7：车身-EBS控制器科密 8：车身-VCU控制器 11：车身-电车车身系统故障 12：车身-电车电机故障 13：车身-电车电池故障
    unsigned long TP_DT_Byte6;//SPN_MSB
    unsigned long TP_DT_Byte7;//num

    //电车
    //Vehicle fault diagnosis

    unsigned short DTC_Sequence_number;//电车故障包序号

    unsigned short FMI;//DTC FMI
    unsigned short SPN_MSB;//DTC SPN_MSB

    unsigned short SPN_LSB;//DTC SPN_LSB

    unsigned short Error_level;//故障等级
    boolean Multi_Send_Enable;//故障码多包发送使能位
    unsigned short Fault_resource;//0：无故障 1：车身-组合仪表IC 2：SYMC电器控制系统 3：车身-变速箱TCU 4：车身-潍柴发动机ECU 5：车身-丹佛斯转向系统1 6：车身-丹佛斯转向系统2
    //7：车身-EBS控制器科密 8：车身-VCU控制器 11：车身-电车车身系统故障 12：车身-电车电机故障 13：车身-电车电池故障

    unsigned short Multi_Send_Num;//多包发送包数


    float Auxiliary_driveMotor_Error_list;//辅助电机故障列表
    float Main_driveMotor_Error_list;//主电机故障列表
    unsigned long Mauxiliary_DriveMotor_Fault;//辅助电机故障码
    unsigned long Main_DriveMotor_Fault_Code;//主电机故障码
    unsigned long TCU_SystemFault_Code_Table;//TCU系统故障码
    unsigned long TCU_OtherFault_Code_Table;//TCU其他故障码
    //7
    unsigned long occurrence_Count1Copy2;
    unsigned long Conversion_MethodCopy_2;
    unsigned long steering_1_safety_controller_failure_level_elec;//转向1安全控制器故障等级
    unsigned long turn_to_1_safety_controller_elec;//转向1安全控制器SPN_LSN
    unsigned long turn_to_1_safety_controller_SPN_MSB_elec;//转向1安全控制器SPN_MSB
    unsigned long steering_1_safety_controller_FMI_elec;//转向1安全控制器FMI
    unsigned long Protect_LampStatusc_Copy_2;
    unsigned long Amber_WarningLamp_Status_Copy_2;
    unsigned long Red_StopLamp_Status_Copy_2;
    unsigned long Malfunction_IndicatorLamp3;
    //7
    unsigned long occurrence_Count1Copy3;
    unsigned long Conversion_MethodCopy_3;
    unsigned long steering_1_main_controller_failure_level_elec;//转向1主控制器故障等级
    unsigned long turn_to_1_master_controller_SPN_LSN_elec;//转向1主控制器SPN_LSN
    unsigned long go_to_1_master_controller_SPN_MSB_elec;//转向1主控制器SPN_MSB
    unsigned long turn_to_1_main_controller_FMI_elec;//转向1主控制器FMI
    unsigned long Protect_LampStatusc_Copy_3;
    unsigned long Amber_WarningLamp_Status_Copy_3;
    unsigned long Red_StopLamp_Status_Copy_3;
    unsigned long Malfunction_IndicatorLamp4;
    //7
    unsigned long occurrence_Count1Copy4;
    unsigned long Conversion_MethodCopy_4;
    unsigned long steering_2_safety_controller_failure_level_elec;//转向2安全控制器故障等级
    unsigned long steering_2_safety_controller_SPN_LSN_elec;//转向2安全控制器SPN_LSN
    unsigned long steering_2_Safety_Controller_SPN_MSB_elec;//转向2安全控制器SPN_MSB
    unsigned long steering_2_Safety_Controller_FMI_elec;//转向2安全控制器FMI
    unsigned long Protect_LampStatusc_Copy_4;
    unsigned long Amber_WarningLamp_Status_Copy_4;
    unsigned long Red_StopLamp_Status_Copy_4;
    unsigned long Malfunction_IndicatorLamp5;
    //7
    unsigned long occurrence_Count1Copy5;
    unsigned long Conversion_MethodCopy_5;
    unsigned long steering_2_main_controller_failure_level_elec;//转向2主控制器故障等级
    unsigned long turn_to_2_master_controller_SPN_LSN_elec;//转向2主控制器SPN_LSN
    unsigned long go_to_2_master_controller_SPN_MSB_elec;//转向2主控制器SPN_MSB
