
/*车云->控制命令集合*/
enum NetToCtlTypeEnum {
    cmd_control_null,
    cmd_hot_car   /*热车*/
};

//车云->控制
struct NetToControl_Cmd
{
    NetToCtlTypeEnum CtrlCmd;   /*命令类型*/        
    long seq_num;                /*命令序列号*/
    unsigned long long taskId;       /*云端指令流水号*/
};

//控制->车云
struct NetToControl_Result
{
    NetToCtlTypeEnum CtrlCmd;   /*命令类型*/  
    long seq_num;                /*命令序列号*/
    unsigned long long taskId;   /*云端指令流水号*/
    uint32 type;                 /*1:指代Cmd的ACK，2：指代结果通知*/
	uint32 result;               /*指令执行结果 0：正常，非零错误*/
};

//车云->控制
struct NetToControl_Result_Ack
{
    NetToCtlTypeEnum CtrlCmd;   /*命令类型*/     
    long seq_num;                /*命令序列号*/
    unsigned long long taskId;       /*云端指令流水号*/
};