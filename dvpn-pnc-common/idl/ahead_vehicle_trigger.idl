struct AheadVehicleInfo
{
    long carId;
    long device_type; // 车辆类别（0：矿车，1：挖机，2：RSU，3：装载机，4：洒水车，5：指挥车，6：平地机）
    long ramp;        // 0：平路，1：上坡，2：下坡
};


struct AheadVehicleTrigger
{
    // 由近及远存（80m内）
    long long timestamp;
    sequence<AheadVehicleInfo> forwardVehicles; // 前车列表
    sequence<AheadVehicleInfo> meetVehicles;    // 会车列表
};