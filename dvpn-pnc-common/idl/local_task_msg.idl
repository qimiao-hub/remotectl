#ifndef __LOCAL_TASK_MSG_IDL__
#define __LOCAL_TASK_MSG_IDL__

struct behavioralFeedbackInfo
{
    uint32 arrive_target_point; //0前往目的地，1到达目的地
    uint32 park_reason; //默认非停车，1V2V停车，2遇障停车，3故障停车，12坡道停车
    string v2v_info; //v2v风险车辆vin号
    int32 allow_secondary_dump;  //0不允许二次卸料，1允许二次卸料， -1初始化值不处理
    int32 reverse_slope_abnormal;//-1初始化值不处理，0反坡异常
    double reverse_slope_angle;//反坡异常角度
};

#endif
