#ifndef __GLOBAL_PLANNING_IDL__
#define __GLOBAL_PLANNING_IDL__

#include "gps_msg.idl";

struct GlobalPlanning
{
    sequence<GPSInfo,80000> MainPathList;     //前进行驶路径
    sequence<GPSInfo,40000> ParkingPathList;  //倒车行驶路径
    char read_state;//读取路径状态：0x00:空闲,0x01:正在读取 0x02:读取成功 0x03::读取失败
    char plan_state;//动态规划状态：0x00:空闲,0x01:正在规划 0x02:规划成功 0x03::规划失败
    long point_key;//关键点坐标
    double forward_stop_lat;
    double forward_stop_lng;
    float forward_stop_head;
    long road_state;    //路径状态：0空载，1满载
    long sub_task_type;  //后续任务类型：0停车，1装载，2卸载，3切换任务
};

#endif