#ifndef __DECIDE_BEHAVIOR_IDL__
#define __DECIDE_BEHAVIOR_IDL__

enum Task_Drive_Control
{
    TASK_CONTROL_FRONT,     //前行
    TASK_CONTROL_BACK,      //倒车
    TASK_CONTROL_STOP_POINT,//停车，定点停车
    TASK_CONTROL_STOP_NOW,  //停车，立即停车
    TASK_CONTROL_DUMP,     //卸料
    TASK_CONTROL_SLOW_STOP,  //缓停
    TASK_CONTROL_OFFLINE_STOP  //离线停车
};

struct TaskParkPoint{
    double lontitude; //经度
    double latitude;  //纬度
    float heading;    //航向角
    float altitude;   //高程     add
};

struct TaskBehaviorControl{
    Task_Drive_Control driveControl; //车辆的控制命令
    TaskParkPoint point; //停车点位置
};

#endif