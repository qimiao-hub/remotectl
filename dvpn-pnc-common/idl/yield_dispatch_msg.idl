#ifndef __YIELD_DISPATCH_MSG_IDL__
#define __YIELD_DISPATCH_MSG_IDL__

enum CtrlCmdType
{
    CMD_NONE,
    MEET_VEHICLE_STOP,
    MEET_VEHICLE_START
};

struct CtrlCmd_req
{
    string client_id;
    long req_id;

    CtrlCmdType cmd;
    char vin[18];
};

struct CtrlCmd_res
{
    string client_id;
    long req_id;

    CtrlCmdType cmd;
    char vin[18];
};

#endif