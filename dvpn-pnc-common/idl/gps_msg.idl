#ifndef __GPS_MSG_IDL__
#define __GPS_MSG_IDL__

enum Slope_type
{
    FLAT,
    UP_HILL,
    DOWN_HILL
};

struct GPSInfo
{
    double iLongitude;//经度
    double iLatitude;//纬度
    float altitude;//高度
    float iHead;//方位角
    float velocity;  //速度
    float acceleration;  //加速度
    float left_boundary;   //左侧边界距离
    float right_boundary;  //右侧边界距离
    float iDistance;//距离
    float iCurvature;//曲率
    float dist_origin;//距离原点的距离
    float road_width;
    long road_type;
    long isWaitPoint;
    long prop3;
    Slope_type slope_type;  //大于1.7度为上坡，小于-1.7为下坡
    float slope; //角度：-90度 － 90度
    uint32 node_type;//前行或倒车标志位： 0：正常前进点 1：前进停车点；换向点，在此点开始预描 2：前进路线终点，预描路线终点 
                  //3：普通倒车点 4：倒车停车点，装料点,在此点开始预描 5：倒车路线终点，从装料点开始预描路线的终点 6：换向前进预描点
                  //7:倒车预描点 8:入场点，在此点开始预描 9:入场前进预瞄点 10:入场预瞄前进路线终点 
    string roadID;
    float dist_road_end;
    float left_road_width; //左侧可行道路宽度
    string left_road_id; //对向车道id
    float max_speed;  //限速
    uint32 cross_type; //交叉点类型
    uint64 time_stamp; //时间戳，毫秒
    float left_wall;   //左侧挡墙距离
    float right_wall;  //右侧挡墙距离
    uint32 detour;     //是否允许超车 1：允许
};

#endif