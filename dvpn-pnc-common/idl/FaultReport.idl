struct FaultReport_req
{
	string client_id;
	long req_id;

	string seq_id;            //消息唯一id
	uint32  module_type;      //模块名称,按照故障码表填
	long report_time;         //故障上报时间
	long fault_id;            //故障码
};

struct FaultReport_res
{
	string client_id;
	long req_id;

	string seq_id;
	long recv_flag;
};



