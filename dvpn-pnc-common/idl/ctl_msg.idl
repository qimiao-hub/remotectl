#ifndef __CTL_MSG_IDL__
#define __CTL_MSG_IDL__

struct CtlResultInfo
{
    float throtle_pedal; // 油门大小 %
    float brake_pedal; // 缓速器开度 %
    float mechanical_pedal;// 行车制动 %
    float steer_angle; // 前轮转角 degree
    float bia_v; //速度偏差
    float bia_v_sum;
    float bia_v_d;
    float acceleration;
    float dev_angle_ctl;//两个转角
    float dev_heading_ctl;
    float f_drive;
    float t_drive;
    short shift_ctrl;//2:D 3:N 4:R
    short bucket_ctrl;//0:保持 1:上升 2:下降
    boolean park_ctrl;//1:驻车 0:解除
    long brake_mode; // 制动模式 0:缓速制动 1：行车制动 2：行车制动+缓速制动
    float heading_angle_deviation_at_prepoint;//角度偏差
    float angle_deviation_at_prepoint;//角度偏差2
    float bia_distance;//距离偏差,m
    float slope_preview;   //预瞄坡度
    float speed_preview;   //预瞄速度
    float preview_dis; // 预瞄距离，m
    float curve_max;
    long preview_point;
    boolean whistle;//鸣笛
    long set_max_gear;
    boolean air_pressure_alarm;//气压报警
    float desired_spd;    //期望车速
    float active_spd;     //实际车速

    long slope_delay_flag;
    octet vilid_count;
    short vehicle_pitch_abnormal;  //车辆俯仰角姿态异常状态，0-正常 1-异常
    short dump_slope_abnormal;     //卸料反坡异常状态,0-正常 1-异常
    float dump_slope_value;        //卸料反坡-坡度(%)
    uint32 stop_reason;            //停车原因，默认不停车，1故障停车，2坡道停车
};


#endif
