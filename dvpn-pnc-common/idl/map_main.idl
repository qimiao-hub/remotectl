#ifndef __MAP_MAIN_IDL__
#define __MAP_MAIN_IDL__

#include "map_preview_path.idl"


struct NearbyInfo{
    uint8 type;  //类型:１－停止线 2－路侧设备
    double lng;//经度
    double lat; //纬度
    float altitude;   //高度
    float iHead;      //方位角
};

struct MaxSpeed{
    float speed;  //km/h
    double startLng; //经度
    double startLat; //纬度
    double endLng; //经度
    double endLat; //纬度
};

struct MapMain
{
    sequence<string> cross_road;                   //最近路口信息，交叉路:路径ID用逗号隔开，例如"15654423322,551543320"
    //区域类型，交叉路口
    sequence<MapPreviewPath,150> preview_list;     //预瞄路径
    map<string, sequence<NearbyInfo> > ground_objects;           //周边信息
    map<string, sequence<MaxSpeed> > max_speeds;
};


#endif