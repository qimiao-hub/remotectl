#ifndef __TASK_STATE_MSG_IDL__
#define __TASK_STATE_MSG_IDL__

enum Drive_state_child
{
    INIT_STATUS,//初始化状态--0
    WAIT_REMOTE_STATUS,//等待遥控启动命令--1
    WAIT_TASK_STATUS,//等待平台下发任务文件--2
    TASK_UPDATE_STATUS,//读取任务文件--3

    FULL_N2F,//档位由空档切换到前进档--4
    FULL_DRIVING,//满载行驶状态--5
    FULL_BRAKE_STOP,//停车等待状态，换N档--6
    FULL_N2F_2,     //重新换回F挡--7
    FULL_WAIT_CONFIRM,//--8

    EMPTY_N2F,//档位由空档切换到前进档--9
    EMPTY_DRIVING,//空载行驶状态--10
    EMPTY_BRAKE_STOP,//停车等待状态，换N档--11
    EMPTY_N2F_2,//--12
    EMPTY_WAIT_CONFIRM,//--13

    DUMPING_FORWARD,//当前路径行驶--14
    DUMPING_CONST_STEER,//定圆转向状态--15
    DUMPING_FORWARD_STOP,//前行停车--16
    DUMPING_F2N,//停车切换空档状态--17
    DUMPING_WAIT,//--18
    DUMPING_READ_BACK_ROAD,//载入倒车路径状态--19
    DUMPING_N2R,//切换成倒档状态--20
    DUMPING_PREVIEW_BACK,//预瞄卸载点倒车行驶--21
    DUMPING_PARKING,//定点停车状态--22
    DUMPING_R2N,//停车切换到空档--23
    DUMPING_BUCKETLIFT,//举升状态--24
    DUMPING_LIFT_WAIT,//举升等待状态--25
    DUMPING_N2F,//切换到前进档状态--26
    DUMPING_FORWARD_LIFTING,//举升前向状态--27
    DUMPING_F2N_2,//切换到空档状态--28
    DUMPING_BUCKET_DOWN,//降斗状态--29
    DUMPING_LIFT_DOWN_WAIT,//--30
    DUMPING_READ_ROAD,//载入路径文件状态--31
    DUMPING_WAIT_CONFIRM,//--32

    LOADING_FORWARD,//沿当前路径行驶--33
    LOADING_CONST_STEER,//定圆转向状态--34
    LOADING_FORWARD_STOP,//前行停车--35
    LOADING_F2N,//停车切换空档状态--36
    LOADING_WAIT,//--37
    LOADING_READ_BACK_ROAD,//载入倒车路径状态--38
    LOADING_N2R,//切换成倒档状态--39
    LOADING_PREVIEW_BACK,//预瞄卸载点倒车行驶--40
    LOADING_PARKING,//定点停车状态--41
    LOADING_R2N,   //停车切换到空档--42
    LOADING_WAIT_CMD,//等待驶出命令--43
    LOADING_READ_ROAD,//载入路径文件状态--44
    LOADING_WAIT_CONFIRM,//--45

    CHARGEING_N2F,//--46
    CHARGEING_DRIVING,//--47
    CHARGEING_ARRIVED,//--48

    PARKING_N2F,//--49
    PARKING_DRIVING,//--50
    PARKING_ARRIVED,//--51
    PARKING_FORWARD,//--52
    PARKING_F2N,//--53
    PARKING_READ_BACK_ROAD,//--54
    PARKING_N2R,//--55
    PARKING_PREVIEW_BACK,//--56
    PARKING_PARKING,//--57
    PARKING_R2N,//--58
    PARKING_COMPLETE,//--59

    MAN_DRIVING_STATE_CHILD,   //有人驾驶状态--60

    TEMPPARKING_DRIVING,//前往临停状态--61
    TEMPPARKING_ARRIVED//到达临停状态--62

};

enum Drive_state
{
    INIT,//初始化状态
    FULL,//满载行驶状态
    EMPTY,//空载行驶状态
    DUMP,//卸载状态
    LOAD,//装载状态
    CHARGE,
    PARK,

    MAN_DRIVING_STATE,  //有人驾驶状态
    PARK_ROAD,   //停车场主路径行驶
    TEMPPARK,  //临停路径行驶
    OIL, //加油路径行驶
    REPIRE, //维修路径行驶
    WATER, //洒水路径行驶
    SUSPEND, //暂停
    OILWAITPOINT, //加油等待点
    OILPOINT //加油点
};

enum Main_state
{
    MAN_DRIVING,   //有人驾驶
    UNMAN_DRIVING,      //无人驾驶
    REMOTE_DRIVING     //遥控驾驶

};


#endif