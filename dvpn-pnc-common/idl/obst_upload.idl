//仅供参考，详细需要感知、规控、车辆网接后呈现

//【校正原因】感知定义的坐标原点为后轴中心，运营人员一般以车头、车尾、车侧作为参照，两者存在认知偏差

// 经纬度是用来在平台绘制障碍物中心点与轮廓点的位置
//【校正】后的车体坐标是用来详情界面呈现在描述给调度员看，障碍物相对于，车头、车侧的位置、类型


/*上传包围盒类型：上传类别、自车位置、包围盒位置长宽角、散点的vector为空
*上传散点类型：上传类别、自车位置、散点的vector非空、包围盒位置长宽角（初始值0即可）
*/

  
//校正规则：原来正数的纵坐标，减 7，纵坐标车后轴中心下  9 米，变成车头前 2 米
//校正规则：原来负数的纵坐标，加 3，纵坐标车后轴中心下 -5 米，变成车尾后 2 米
//校正规则：原来正数的横坐标，减 4.5 ，横坐标车后轴中心下  7.5 米，变成车右侧 3 米
//校正规则：原来负数的横坐标，加 4.5，横坐标车后轴中心下  -8.5 米，变成车左侧 4 米  

struct VehicleGPS
{
    float lng;//自车经度
    float lat;//自车纬度
    float head;//自车航向
};

struct ScatterGPS
{
    float figLngCorrect;//校正后的横坐标
    float figLatCorrect;//校正后的纵坐标
};

struct ObstInfo
{
    short type;//0是包围盒，1是散点
    short labelShow;//举例：0 车辆、1 行人 2 其他、共三个类别，区分不同颜色显示，参考上文的感知类别label定义
    short label;//举例：0 灰尘、1车辆、2等等，参考上文的感知类别label定义
    VehicleGPS pose;//自车位置
    float centerxCorrect;//校正后的障碍物横坐标（包围盒、轮廓中心点横坐标），单位：米                  
    float centeryCorrect;//校正后的障碍物纵坐标（包围盒、轮廓中心点纵坐标），单位：米
    float head;//包围盒航向角（单位：角度（范围：0~360，正北为起点顺指针转））
    float length;//包围盒长度（单位：米，精度小数点后两位）
    float width;//包围盒宽度（单位：米，精度小数点后两位）
    sequence<ScatterGPS> scatterFigs;//散点的轮廓点经纬度
};

 struct ObstUpdateInfo
 {
    float lng;//散点、包围盒中心点的横坐标，转成经度
    float lat;//散点、包围盒中心点的纵坐标，转成纬度
    ObstInfo info;
};