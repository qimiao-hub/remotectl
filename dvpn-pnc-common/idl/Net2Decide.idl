
/*************************************(车云、V2X)车联网-决策交互*****************************************/

/*
发车指令使用原有的指令交互不做变更
*/


/*车控指令枚举 车联网---->决策*/
enum Cmd_To_Decide
{
    schedule_cmd_null,
    schedule_cmd_stop,                   /*急停*/
    schedule_cmd_slow_stop,              /*缓停（停车到指定点位）*/
    schedule_cmd_recover,                /*恢复（通行）*/
    schedule_cmd_start,                  /*发车*/
    schedule_cmd_task_cancel,            /*任务取消*/
    schedule_cmd_req_points            /*请求到达目标点时间*/
};

/*车辆停车状态(原因)*/
enum CmdStopReason_Enum
{
    CmdStopReason_Manual,			        //  人工急停 转 0x06 (上传 / 下发)
    CmdStopReason_TraffiCtrl_SlowStop,      //  定点缓停交通管制 转 0x07 (上传 / 下发)
    CmdStopReason_TraffiCtrl_Emergency,     //  急停交通管制 转 0x08     (上传 / 下发)
    CmdStopReason_NotGenPath,               //  无法生成路径 转 0x09     (上传 / 下发)
    CmdStopReason_NotLoadBalance,           //  无法负载均衡 转 0x0A     (上传 / 下发)
    CmdStopReason_PlatformOffline          //  平台离线 转 0x0B     (上传 / 下发)
};

/*缓停点位*/
struct Slow_Stop_Point
{
    string junctionID;                   //Junction ID
    double lontitude;                    //经度
    double latitude;                     //纬度
    float heading;                       //航向角
    CmdStopReason_Enum stopReason;                    //停车原因
};

/*请求到到达目标点*/
struct ReqTime_Arrive_Point
{
    string roadID;                       //路段ID
    double lontitude;                    //经度
    double latitude;                     //纬度
    float heading;                       //航向角
    long long req_time;                  //请求到达时间 -1
    long req_source;                     //0:RSU， 1:平台
};
// RSU 发送  1. lon lat 指定时间  2. 发送 lon lat ， 需要决策计算时间后返回


/*指令附加消息联合体*/
union Net_Cmd_Msg switch(long)
{
    case 1:
        Slow_Stop_Point stop_point;
    case 2:
        sequence<ReqTime_Arrive_Point> req_points;
    case 3:
        CmdStopReason_Enum stop_reason;
};

/*指令 车联网 ----> 决策*/
struct NetToDecide
{
    Cmd_To_Decide cmd;          /*指令*/
    long cmd_priority;          /*指令优先级*/
    Net_Cmd_Msg message;        /*指令附加消息*/
    long seq_num;               /*序列号*/
    long source;                /*消息来源; 0:v2x， 1:netcloud*/
};


/*指令接收响应 决策 ----> 车联网*/
struct NetToDecide_Ack
{
    Cmd_To_Decide cmd;          /*指令*/
    long seq_num;               /*序列号*/
    long source;                /*消息来源; 0:v2x， 1:netcloud*/
    long result;                /*0,成功，非零，失败*/
};

struct Expect_Arrive_Point
{
    long duration;          //到达目标点剩余时间
    float distance;         //到达目标点剩余距离 单位m, 精度0.01m
    uint64 timeCtrlMin;     //时间控制允许最小值 无效时传0xffffffff
    uint64 timeCtrlMax;     //时间控制允许最大值 无效时传0xffffffff
    string roadID;          //请求路段id
    long source;            //0:rsu 1:平台

};

/*预期到达目标点时间集合, 定频外发1s   决策 ---> 车联网*/
struct Expect_Arrive_PointTime
{
    sequence<Expect_Arrive_Point> expect_arrive_points;
};


/*****************************************车云-V2X交互****************************************/

/*RSU路口配置*/
struct RSU_Crossing
{
    string rsu_id;
    sequence<string> crossing_ids;
};

struct RsuAndV2x_Conf
{
    sequence<RSU_Crossing> rsu_crossed;
};

// /*RSU启用配置*/
// struct RsuUse_Conf
// {
//     map<string, long> rsu_use;  //RSU Id : 0（关闭） 1（启用） 
// }; 

/*车控指令枚举 车云---->V2X*/
enum Cmd_To_V2X
{
    schedule_cmd_v2x_null,
    schedule_cmd_v2x_stop,                   /*急停*/
    schedule_cmd_v2x_slow_stop,              /*缓停（停车到指定点位）*/
    schedule_cmd_v2x_recover,                /*恢复（通行）*/
    schedule_cmd_v2x_start,                  /*发车*/
    schedule_cmd_v2x_task_cancel,            /*任务取消*/
    schedule_cmd_v2x_req_points,             /*请求到达目标点时间*/
    schedule_cmd_v2x_rsu_config,             /*rsu配置指令（v2x）,配置*/
    schedule_cmd_v2x_rsu_use                 /*RSU管控配置指令*/
};

/*指令附加消息联合体*/
union Net_V2X_Cmd_Msg switch(long)
{
    case 1:
        Slow_Stop_Point stop_point;
    case 2:
        sequence<ReqTime_Arrive_Point> req_points;
    case 3:
        RsuAndV2x_Conf rsu_cross_conf;
    case 4:
        long rsu_uses;                      /*0:关闭RSU管控  1:启用RSU管控*/ 
    case 5:
        CmdStopReason_Enum stop_reason;
};


/*指令消息  车云--->V2x   (低优先级别消息，由V2x过滤后转发给决策)*/
struct NetToV2x
{
    Cmd_To_V2X cmd;             /*指令*/
    long cmd_priority;          /*指令优先级*/
    Net_V2X_Cmd_Msg message;        /*指令附加消息*/
    long seq_num;               /*序列号*/
};

/*指令接收响应 V2x ----> 车云*/
struct NetToV2x_Ack
{
    Cmd_To_V2X cmd;          /*指令*/        
    long seq_num;               /*序列号*/
    long result;                /*0,成功，非零，失败*/
};