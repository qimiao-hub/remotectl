#ifndef __VEHICLE_TASK_MSG_IDL__
#define __VEHICLE_TASK_MSG_IDL__

#include "task_state_msg.idl"

const int32 PATH_SIZE = 1000;

struct V2XGPSInfo
{
    double iLongitude;//经度
    double iLatitude;//纬度
    float altitude;//高度
    float iHead;//方位角
    float velocity;  //速度
    float iCurvature;//曲率
    int32 slope_type;　//0平地 1上坡 2下坡
    float slope;　//大于1.7度为上坡，小于-1.7为下坡
    uint32 node_type;//前行或倒车标志位： 0：正常前进点 1：前进停车点；换向点，在此点开始预描 2：前进路线终点，预描路线终点 
                  //3：普通倒车点 4：倒车停车点，装料点,在此点开始预描 5：倒车路线终点，从装料点开始预描路线的终点 6：换向前进预描点
                  //7:倒车预描点 8:入场点，在此点开始预描 9:入场前进预瞄点 10:入场预瞄前进路线终点 
    long long arrive_timestamp;
};

struct VehicleTaskInfo
{
    //状态机相关
    Main_state main_state;
    Main_state main_state_last;
    Drive_state drive_state;
    Drive_state drive_state_last;
    Drive_state_child drive_state_child;
    Drive_state_child drive_state_child_last;
    int32 stop;//停车类型

    sequence<V2XGPSInfo,PATH_SIZE> pre_path;

};


#endif