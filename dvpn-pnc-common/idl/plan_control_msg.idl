#ifndef __PLAN_CONTROL_MSG_IDL__
#define __PLAN_CONTROL_MSG_IDL__

#include "decide_state_machine.idl"
#include "decide_msg.idl"


enum Moving_Direction{
    MOVING_FRONT,  //前
    MOVING_BACK,   //后
    MOVING_STOP    //停车
};

struct LocalPlanResultInfo
{
    //状态机相关
    Task_Main_State task_main_state;
    Task_Sub_State task_sub_state;

    float desired_speed;    //期望车速
    Moving_Direction direction;
    boolean perception_flag;
    boolean dump_action; //卸料
    unsigned long index; //索引
    sequence<GPSInfo,SEQ_MAX_SER_SIZE1> LocalPathList;
    float obs_dis;
    float dis_to_end;
    boolean emergency_stop;
    boolean slow_down;
    GPSInfo target_gps;
    boolean is_whistle;//true : 鸣笛, false : 不鸣笛
    int32 redGreenRoad;//0:正常道路，1:红绿灯路口
    int32 roadType;///0:其他类型，1：起坡道(仅卸料倒车时进行处理)
};

#endif
