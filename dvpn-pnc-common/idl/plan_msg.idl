#ifndef __PLAT_MSG_IDL__
#define __PLAT_MSG_IDL__

#include "gps_msg.idl"

const int32 SEQ_MAX_SER_SIZE2 = 100000;
const int32 SEQ_MAX_SER_SIZE3 = 5000;

struct PlanResult
{
    sequence<GPSInfo,SEQ_MAX_SER_SIZE2> MainPathList;     //前进行驶路径
    sequence<GPSInfo,SEQ_MAX_SER_SIZE3> ParallelPathList; //前进行驶路径 
    sequence<GPSInfo,SEQ_MAX_SER_SIZE3> ParkingPathList;  //倒车行驶路径
    sequence<GPSInfo,SEQ_MAX_SER_SIZE3> workAreaList;  //边界点
    sequence<GPSInfo,SEQ_MAX_SER_SIZE3> startAreaList;  //起始边界点，而workAreaList对应目标边界点
    sequence<GPSInfo,SEQ_MAX_SER_SIZE2> mapPathList;  //地图路径
    sequence<string> roadIDList;  //道路列表
   
    char read_state;//读取路径状态：0x00:空闲,0x01:正在读取 0x02:读取成功 0x03::读取失败
    char plan_state;//动态规划状态：0x00:空闲,0x01:正在规划 0x02:规划成功 0x03::规划失败
    long point_key;//关键点坐标
    double forward_stop_lat;   //换向点纬度：同时有前进和后退路径时，该值有效果
    double forward_stop_lng;   //换向点经度：同时有前进和后退路径时，该值有效果
    float forward_stop_head;   //换向点航向角：同时有前进和后退路径时，该值有效果
    long road_state;    //路径状态：0空载，1满载，参照平台下发任务类型　Destination_Enum

    double target_point_lat;   //目标点纬度
    double target_point_lng;   //目标点经度
    float target_point_head;   //目标点航向角
    
    long sub_task_type;  //后续任务类型：0停车，1装载，2卸载，3切换任务
    int32 is_multiple_parking;//是否多次泊车，0不是多次泊车，1是多次泊车
    int32 have_next_plan; //泊车是否完成 1:还要继续泊车 0：泊车完成
};

#endif
