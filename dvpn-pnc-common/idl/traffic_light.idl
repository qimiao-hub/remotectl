{
    char road_id[33];
    long long timestamp;//ms
};

enum VehicleCtrlCmd_Enum
{
    CTRL_CMD_NONE,
    CTRL_CMD_STOP,
    CTRL_CMD_RUN,
    CTRL_CMD_DECELERATE //减速
};

struct VehicleCtrlCmd
