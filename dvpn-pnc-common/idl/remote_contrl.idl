/*远程启动命令集*/
enum RemoteCmd_Enum
{
    Cmd_NULL,          //空指令0
	Cmd_Auto,          //远程进无人 1
    Cmd_Man            //远程退无人 2
};

/*远程命令*/
struct CloudRemoteCtl
{
	RemoteCmd_Enum RmtCmd;   /*远程命令*/
    long Seq_Num;            /*命令流水号*/
};


/*命令回执*/
struct CloudRemoteCtlAck
{
	RemoteCmd_Enum RmtCmd;      /*远程命令*/
    long Seq_Num;               /*命令流水号*/
	long Result;                /*命令执行结果，仅确认命令收到*/
};

/*远程灯光控制命令集*/
enum CtrLight_Enum
{
    Light_OFF,                   //灯光关闭 0
    Light_ON,                   //灯光打开 1 
    Light_NULL                 //无效 2
};

/*灯光控制消息*/
struct VehicleLightCtrl
{
    CtrLight_Enum HighBeam;         /*远光灯*/
    CtrLight_Enum LowBeam;          /*近光灯*/
    CtrLight_Enum Explosive;        /*爆闪灯*/
    CtrLight_Enum DoubleFlash;      /*双闪灯*/
    CtrLight_Enum FogLamp;          /*雾灯*/
    CtrLight_Enum PositiomLight;    /*示廓灯*/
    CtrLight_Enum HeadLamp;         /*前照灯*/
    CtrLight_Enum RearHeadLamp;     /*后照灯*/
};

/*空调控制消息*/
struct VhehicleAirDCtrl
{
    octet on_off;           //开关       0x00关闭 0x01打开
    octet ac;               //AC        0x00关闭 0x01打开
    octet auto_air;             //AUTO      0x00关闭 0x01打开
    octet defrost;          //除霜       0x00关闭 0x01打开
    octet circulate;        //内外循环   0x00内循环 0x01外循环
    octet wind_direction;   //风向       0x00吹面 0x01 吹面吹脚 0x02吹脚
    octet wind_speed;       //风速      0-8 
    octet temp;             //温度      17-32

};

union CloudToVehicle_Ctrl switch(long)
{
    case 1:
        VehicleLightCtrl light_ctrl;        //灯光控制
    case 2:
        VhehicleAirDCtrl air_ctrl;          //空调控制
};


/*远程车辆控制命令*/
struct CloudVehicleCtr
{
    CloudToVehicle_Ctrl vehicle_ctrl;
    long Seq_Num;                   /*命令流水号*/
};   

/*车辆在线状态*/
struct VehicleStatus
{
    long status;               /*0:offline,1:online*/
};

/*命令回执*/
struct CloudVehicleCtrAck
{
    long Seq_Num;               /*命令流水号*/
	long Result;                /*命令执行结果，仅确认命令收到*/
};

