#ifndef __PERCEPTION_MSG_IDL__
#define __PERCEPTION_MSG_IDL__

//定义感知dds消息使用的结构体
//传感器状态，不再发布传感器状态
struct DDS_PS_Online_Status
{
    // DDS_Peception_Sensor_Online_Status
    @ default(0) long long stamp;
    short lidar_state_[4];
    short radar_state_[4];
    short camera_state_[4];
};
//3维坐标点
struct DDS_PointXYZ
{
    // 基于自车坐标系
    @ default(0) float point_x;  // X坐标
    @ default(0) float point_y;  // Y坐标
    @ default(0) float point_z;  // Z坐标
};
//挡墙点
struct DDS_CurbPoint
{
    @ default(0) float point_x;  // X坐标
    @ default(0) float point_y;  // Y坐标
};

struct DDS_CurbLidarPoints
{
    @ default(0) long long stamp;

    sequence<DDS_CurbPoint, 180> f_curbs;//前向挡墙点
    sequence<DDS_CurbPoint, 180> b_curbs;//后向挡墙点
};

struct DDS_CurbFusePoints
{
    @ default(0) long long stamp;

    //车辆后轴中心定位信息
    double gps_lat_10ms;           // 纬度
    double gps_lng_10ms;           // 经度
    float gps_heading_10ms;        // 航向角

    // 前后向挡墙点
    sequence<DDS_CurbPoint, 180> f_curbs;   //前向挡墙点
    sequence<DDS_CurbPoint, 180> b_curbs;   //后向挡墙点
};
//毫米波目标
struct DDS_RadarInfo
{
    @ default(0) long long stamp; // time_stmp;
    @ default(0) long speed_direction;
    @ default(0) float speed;
    @ default(0) float yaw_rate;

    @ default(0) long id;         // Object_ID;
    @ default(0) float dist_long; // Object_DistLong;
    @ default(0) float dist_lat;  // Object_DistLat;
    @ default(0) float vrel_long; // Object_VrelLong;
    @ default(0) float vrel_lat;  // Object_VrelLat;
    @ default(0) long dyn_prop;   // Object_DynProp;
    @ default(0) float rcs;       // Object_RCS;

    @ default(0) long dist_long_rms;   // Obj_DistLong_rms;
    @ default(0) long dist_lat_rms;    // Obj_DistLat_rms;
    @ default(0) long vrel_long_rms;   // Obj_VrelLong_rms;
    @ default(0) long vrel_lat_rms;    // Obj_VrelLat_rms;
    @ default(0) long arel_lat_rms;    // Obj_ArelLat_rms;
    @ default(0) long arel_long_rms;   // Obj_ArelLong_rms;
    @ default(0) long orientation_rms; // Obj_Orientation_rms;
    @ default(0) long meas_state;      // Obj_MeasState;
    @ default(0) long prob_of_exit;    // Obj_ProbOfExit;

    @ default(0) float arel_long;         // Object_ArelLong;
    @ default(0) float arel_lat;          // Object_ArelLat;
    @ default(0) long object_class;       // Object_Class;
    @ default(0) float orientation_angle; // Object_OrientationAngel;
    @ default(0) float length;            // Object_Length;
    @ default(0) float width;             // Object_Width;
};
//毫米波目标list
struct DDS_RadarInfos
{
    @ default(0) long long stamp;
    sequence<DDS_RadarInfo, 200> objects;
};
//激光雷达点云点
struct DDS_LidarPoint
{
    @ default(0) float point_x;
    @ default(0) float point_y;
    @ default(0) float point_z;
    @ default(0) octet intensity;
    @ default(0) octet time_stamp;
    @ default(0) octet ring;
};
//激光雷达点云帧
struct DDS_LidarCloud
{
    @ default(0) long long stamp;
    sequence<DDS_LidarPoint, 80000> points;
};
//图像数据
struct DDS_Image
{
    @ default(0) long long stamp;
    @ default(0) octet mat[4147200];
};
//散点目标
struct DDS_ScatterObject
{
    @ default(0) long seq;                 // 当前障碍物序号，依次递增
    @ default(0) long long stamp;          // 时间戳
    @default(0) long object_type;       // Obstacle type: 0-"unknown",暂无类别，默认为0 1."挡墙" 2.“灰尘”
    @ default(0) long tracker_id_;         // 追踪ID
    @ default(0) long track_cnt;           // 跟踪检测次数
    @ default(0) long lost_cnt;             //追踪丢失的帧数
    @ default(0) float confidence;         //类别置信度  
    @ default(0) float theta;              //航向角
    @ default(0) float center[3];          // 障碍物中心点坐标
    @ default(0) long obj_num;             // 实际点数
    sequence<DDS_PointXYZ, 256> obj_points; // 障碍物轮廓点,仅保留x,y，z，最大点数256
    @ default(0) float objects[512];       // 障碍物轮廓点,仅保留x,y，最大点数256
    @ default(0) float vrel_y;             // 前车与本车的纵向相对速度，单位m/s
    @ default(0) float vrel_x;             // 前车与本车的横向相对速度，单位m/s
    @ default(0) float vrel_z;             // 前车与本车的z向相对速度，单位m/s 
    @ default(0) float velocity;           // 旋转角速度，单位m/s
    @ default(0) long frame_associate_num; // 帧与帧关联的次数  
    @ default(0) short is_movable;    //0未知  1：正在移动  2：静止
    @ default(0) float vertical_area;             // 俯视面积（平方米）
    @ default(0) float front_area;           // 前视面积    单位（平方米）
};
//散点目标列表
struct DDS_ScatterObjects
{
    @ default(0) long long stamp;  //帧时间戳
    sequence<DDS_ScatterObject, 200> objects;
};
//box 目标
struct DDS_Box
{
    @ default(0) long long stamp;          // 每个box处理后的时间戳 
    @ default(0) long tracker_id_;         //追踪ID
    @ default(0) long tracker_cnt_;         //追踪检测到的次数
    @ default(0) long lost_cnt_;         //追踪丢失的帧数
    @ default(0) float confidence;         //类别置信度
    @ default(0) unsigned long object_type;    // 目标障碍物类型: 具体根据图像标注文件确定障碍物类型0-unknow 1-widetruck
    @ default(0) unsigned long detection_type;  // 检测类型：0：未知;1:激光雷达AI；2：毫米波雷达；3：图像2D；4:图像3D；5：点云传统；6：点云AI与点云传统融合；7：点云传统与毫米波融合...具体定义参考SensorsType；*/
    @ default(0) float center[3];            //障碍物中心点坐标（以车辆后轴中心为原点）
    @ default(0) float object_length;          // 目标障碍物长度
    @ default(0) float object_width;           // 目标障碍物宽度
    @ default(0) float object_height;          // 目标障碍物高度
    @ default(0) float direction[4];          // 障碍物航向角，四元数
    @ default(0) float theta;                 // 障碍物航向角
    @ default(0) float theta_ray;                 // 障碍物方位角
    @ default(0) float rel_vrel_y;       // 前车与本车的纵向相对速度，单位m/s
    @ default(0) float rel_vrel_x;        // 前车与本车的横向相对速度，单位m/s
    @ default(0) float abs_vrel_y;       // 目标障碍物纵向绝对速度，单位m/s
    @ default(0) float abs_vrel_x;        // 目标障碍物横向绝对速度，单位m/s
    @ default(0) float velocity;          //目标障碍物与本车的矢向相对速度，单位m/s
    @ default(0) short is_movable;    //0未知  1：正在移动  2：静止
    @ default(0) float dangerous_rate;  //危险等级0-1
};
//box目标列表，每帧的box输出
struct DDS_BoxObjects
{
    @ default(0) long long stamp;         //帧时间戳
    @ default(0) float global_haze_ratio; // 全局灰尘浓度 0：完全可见， 0.7：可见距离<50m，0.8 ： 可见距离<40m 0.9 ： 可见距离<30m,1.0：可见距离<20m
    @ default(0) float part_haze_ratio; // 可行驶路径 灰尘浓度 0：完全可见， 0.7：可见距离<50m，0.8 ： 可见距离<40m 0.9 ： 可见距离<30m,1.0：可见距离<20m
    @ default(0) short  weather_status; // 0:白天1：背光2：夜间3：雪天4：大雾
    sequence<DDS_Box, 200> objects;
};

struct DDS_AlgorithmInfo
{
    @ default(0) float range;
    @ default(0) float angle;
    @ default(0) float vrel;

    @ default(0) long fuse_num;            // 目标融合处理融合的目标数
    @ default(0) long radar_num;           // 目标融合处理中那种雷达检测到目标，1，左雷达，2，右雷达，3左右雷达，5，中间雷达，6，左中雷达，7，右中雷达，8，左中右雷达
    @ default(0) long frame_associate_num; // 帧与帧关联的次数

    @ default(0) long track_cnt_; // 跟踪检测次数
    @ default(0) float lost_cnt_;
    @ default(0) long tracker_id_;
    @ default(0) float P_[16];
};

struct DDS_RadarObject
{
    DDS_RadarInfo radar_info;
    DDS_AlgorithmInfo alg_info;
};

struct DDS_RadarObjects
{
    @ default(0) long long stamp;
    sequence<DDS_RadarObject, 200> objects;
};


struct DDS_Scatter{
    @ default(0) long long stamp;          // 时间戳
    @ default(0) long tracker_id_;         // 追踪ID
    @ default(0) float confidence;    
    @ default(0) float theta;         
    @ default(0) float center[3];          // 障碍物中心点坐标
    @ default(0) long object_size;         // 障碍物轮廓点实际数量
    @ default(0) float objects[100];        // 障碍物轮廓点，目前50个点，只存储x,y
    @ default(0) float vrel_y;             // 前车与本车的纵向相对速度，单位m/s
    @ default(0) float vrel_x;             // 前车与本车的横向相对速度，单位m/s
};

struct DDS_SensorFuseResult
{
    @ default(0) unsigned long type; //0:box 1:Scatter
    @ default(0) DDS_Box box;
    @ default(0) DDS_ScatterObject scatter;
};

struct DDS_SensorFuseResults
{
    @ default(0) long long stamp;
    @ default(0) float global_haze_ratio; // 全局灰尘浓度 0：完全可见， 0.7：可见距离<50m，0.8 ： 可见距离<40m 0.9 ： 可见距离<30m,1.0：可见距离<20m
    @ default(0) float part_haze_ratio; // 可行驶路径 灰尘浓度 0：完全可见， 0.7：可见距离<50m，0.8 ： 可见距离<40m 0.9 ： 可见距离<30m,1.0：可见距离<20m
    @ default(0) short  weather_status; // 0:白天1：背光2：夜间3：雪天4：大雾
    sequence<DDS_SensorFuseResult, 200> objects;
    short idx ; // 融合输出物体的索引值，1~1000
};
 //驱动发布的IMU、RTK结构体
struct DDS_IMU
{
    @ default(0) double stamp;
    double orientation[4];
    double orientation_covariance[9];
    double angular_velocity[3];
    double angular_velocity_covariance[9];
    double linear_acceleration[3];
    double linear_acceleration_covariance[9];
};
 //驱动发布的IMU、RTK结构体
struct DDS_RTK
{
    @ default(0) double stamp;
    double longitude;
    double latitude;
    double altitude;
    double roll;
    double pitch;
    double yaw;
    double ve;
    double vn;
    double vu;
    uint8 rtk_status;
};
//挡墙边界
struct DDS_FusionCurbMessage
{
    @ default(0) long long stamp;
    @ default(true) boolean support_secondary_discharge; // 是否支持二次卸料
    DDS_LidarCloud curbs; 	 // 输出后向的所有挡墙点云，包括左右
    @ default(100) float distance; // 后向挡墙与车辆后轴中心的y方向的最短距离，单位m
    @ default(100) float left_wheel_distance; // 左边轮到后向挡墙的距离，单位m
    @ default(100) float right_wheel_distance; // 右边轮到后向挡墙的距离，单位m
    @ default(0) float comple_rate; // 挡墙高度完整率，挡墙高度超过0.8m的占比
};
//路径点信息，局部规划模块发布路径点信息用，不建议放在perception.idl.避免出现问题，未修改
struct DDS_Ego
{
    @ default(0) float one_x;//路径点box四个顶点坐标 左上
    @ default(0) float one_y;//规控使用
    @ default(0) float two_x;//右上
    @ default(0) float two_y;
    @ default(0) float thr_x;//右下
    @ default(0) float thr_y;
    @ default(0) float for_x;//左下
    @ default(0) float for_y;
};

struct DDS_PathPoint
{
    @ default(0) float point_x;  // X坐标
    @ default(0) float point_y;  // Y坐标
    @ default(0) float altitude; // 高度
    @ default(0) float distance;//无用
    @ default(0) float slope;     // 坡度
    @ default(0) float curvature; // 曲率
};
struct DDS_PathPoints 
{
    //车体坐标系下路径点
    @ default(0) long long stamp;//当前时间戳
    sequence<DDS_PathPoint,250> path_obj;//路径点
    sequence<DDS_Ego,250> ego_obj;//路径点box坐标
};
#endif
