#ifndef __DECIDE_PLAT_MSG_IDL__
#define __DECIDE_PLAT_MSG_IDL__


#include "gps_msg.idl"
#include "decide_msg.idl"
#include "gps_imu_msg.idl"

struct DecidePlanInfo
{
    //规划相关
    Main_state main_state;  
    Drive_state drive_state; 
    Plan_type  plan_road_cmd;   //规划路径命令，NONE：不操作，TO_STOP：到装卸点规划，TO_START：到起始点规划
    long  read_road_cmd;   //读取路径文件命令，0：不操作，1：读取

    string road_name;
    string boundary_name;  //边界文件

    GPSInfo wait_point;
    VehiclePos stop_point_pos;//装卸载点姿态 

    GpsImuInfo current_gps;
    GPSInfo v2v_avoid_obst_pos; //v2v绕障障碍点的点姿
    DriveStatus  current_drive_status; 
};

#endif